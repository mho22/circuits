{
	"compilerOptions" : {
		"target" : "esnext",
		"module" : "esnext",
		"moduleResolution" : "bundler",
		"isolatedModules" : true,
		"strict" : true,
		"lib" : [ "ESNext", "DOM" ],
		"types" : [ "node", "vite/client" ],
		"skipLibCheck" : true,
		"noEmit" : true,
		"allowImportingTsExtensions" : true,
		"noImplicitAny" : true
	},
	"include" : [ "src/**/*", "tests/**/*" ]
}
